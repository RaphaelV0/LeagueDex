{
  "name": "leaguedex-firestore-security-tests",
  "private": true,
  "type": "module",
  "description": "Development-only Firebase Emulator security checks; no JavaScript app dependency.",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-leaguedex \"node --test --test-concurrency=1 firestore-tests/security.test.mjs\""
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
