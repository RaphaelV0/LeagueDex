rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connected() {
      return request.auth != null;
    }
    function owner(uid) {
      return connected() && request.auth.uid == uid;
    }
    function admin() {
      return connected() && request.auth.token.get('admin', false) == true;
    }

    // A connected user may add a public venue, but cannot alter another
    // venue afterwards. Validate all submitted fields on the server.
    function validNewVenue(data) {
      return data.keys().hasAll([
          'name', 'address', 'latitude', 'longitude',
          'type', 'authorUID', 'createdAt'
        ])
        && data.keys().hasOnly([
          'name', 'address', 'latitude', 'longitude', 'type',
          'openingHours', 'phone', 'website', 'details',
          'authorUID', 'createdAt'
        ])
        && data.authorUID == request.auth.uid
        && data.createdAt == request.time
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.address is string && data.address.size() > 0 && data.address.size() <= 250
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.type in ['Bar E-sport', 'Salle LAN', 'Autre lieu gaming']
        && data.get('openingHours', '') is string
        && data.get('openingHours', '').size() <= 500
        && data.get('phone', '') is string && data.get('phone', '').size() <= 60
        && data.get('website', '') is string && data.get('website', '').size() <= 300
        && data.get('details', '') is string && data.get('details', '').size() <= 1500;
    }

    // Each account can read and update only its own champion favorites.
    // Tombstones preserve explicit deselections through legacy migrations.
    match /users/{uid}/favorites/{championID} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && championID.size() > 0 && championID.size() <= 120
        && request.resource.data.keys().hasAll(['championID', 'selected', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['championID', 'selected', 'updatedAt'])
        && request.resource.data.championID == championID
        && request.resource.data.selected is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Champions and items remain read-only for app users; venues accept only validated new entries.
    match /champions/{id} {
      allow read: if connected();
      allow write: if admin();
    }
    match /items/{id} {
      allow read: if connected();
      allow write: if admin();
    }
    match /venues/{id} {
      allow read: if connected();
      allow create: if admin() || (connected() && validNewVenue(request.resource.data));
      allow update, delete: if admin();
    }

    // No access is granted to retired premium collections. Existing documents
    // are NOT deleted; Admin SDK can export them for backup if needed.
  }
}
