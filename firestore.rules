rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connected() {
      return request.auth != null;
    }
    function owner(uid) {
      return connected() && request.auth.uid == uid;
    }
    function admin() {
      return connected() && request.auth.token.get('admin', false) == true;
    }

    // Each account can read and update only its own champion favorites.
    // Tombstones preserve explicit deselections through legacy migrations.
    match /users/{uid}/favorites/{championID} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && championID.size() > 0 && championID.size() <= 120
        && request.resource.data.keys().hasAll(['championID', 'selected', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['championID', 'selected', 'updatedAt'])
        && request.resource.data.championID == championID
        && request.resource.data.selected is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Read-only catalogs for app users. Admins populate these outside the app.
    match /champions/{id} {
      allow read: if connected();
      allow write: if admin();
    }
    match /items/{id} {
      allow read: if connected();
      allow write: if admin();
    }
    match /venues/{id} {
      allow read: if connected();
      allow write: if admin();
    }

    // No access is granted to retired premium collections. Existing documents
    // are NOT deleted; Admin SDK can export them for backup if needed.
  }
}
